{% assign menu_links = linklists[menu_handle].links %}
{% assign current_collection = '/collections/' | append: collection.handle %}

{% assign found = false %}
{% assign slider_items = blank %}
{% assign visible_count = 0 %}

{% if collection and menu_links.size > 0 %}

  {% for level1 in menu_links %}

    {% if level1.url == current_collection or level1.url contains current_collection %}
      {% assign slider_items = level1.links %}
      {% assign found = true %}
      {% break %}
    {% endif %}

    {% for level2 in level1.links %}

      {% if level2.url == current_collection or level2.url contains current_collection %}

  {% if level2.links.size > 0 %}
    {% assign slider_items = level2.links %}
  {% else %}
    {% assign slider_items = blank %}
  {% endif %}

  {% assign found = true %}
  {% break %}

{% endif %}

      {% for level3 in level2.links %}

        {% if level3.url == current_collection or level3.url contains current_collection %}
          {% assign slider_items = level2.links %}
          {% assign found = true %}
          {% break %}
        {% endif %}

      {% endfor %}

      {% if found %}{% break %}{% endif %}

    {% endfor %}

    {% if found %}{% break %}{% endif %}

  {% endfor %}

{% endif %}

{% if slider_items != blank %}

  {% capture slider_cards %}
    {% for item in slider_items %}

  {%- comment -%} Fix: Exclude Mattresses category from slider {%- endcomment -%}
  {% if item.title contains 'Mattress' %}
    {% continue %}
  {% endif %}

  {% assign item_handle = item.url | split: '/collections/' | last | split: '?' | first | split: '/' | first %}
  {% assign item_collection = collections[item_handle] %}

  {% if item_collection != blank %}

    {% assign current_handle = collection.handle %}

    {% unless item_handle == current_handle %}

      {% assign visible_count = visible_count | plus: 1 %}

      <a href="{{ item_collection.url }}" class="collection-family-slider__card">

        <div class="collection-family-slider__image-wrap">
          {% if item_collection.featured_image %}
            {{ item_collection.featured_image | image_url: width: 700 | image_tag }}
          {% elsif item_collection.products.first.featured_image %}
            {{ item_collection.products.first.featured_image | image_url: width: 700 | image_tag }}
          {% endif %}
        </div>

        <div class="collection-family-slider__content">
          <h3 class="collection-family-slider__title">{{ item_collection.title }}</h3>
        </div>

      </a>

    {% endunless %}

  {% endif %}

{% endfor %}
  {% endcapture %}

  {% if visible_count > 0 %}
    <div class="collection-family-slider-wrapper" id="collection-family-slider-{{ section.id | default: 'snippet' }}">
      
      <button
        type="button"
        class="collection-family-slider__arrow collection-family-slider__arrow--prev is-hidden"
        aria-label="Previous"
        data-slider-prev
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M15.5 19 8.5 12l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="collection-family-slider" data-slider-track>
        {{ slider_cards }}
      </div>

      <button
        type="button"
        class="collection-family-slider__arrow collection-family-slider__arrow--next is-hidden"
        aria-label="Next"
        data-slider-next
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="m8.5 19 7-7-7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>

    <style>
      .collection-family-slider-wrapper {
        position: relative;
        margin: 24px 0;
      }

      .collection-family-slider {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: calc((100% - 48px) / 7);
        gap: 16px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 2px;
      }

      .collection-family-slider::-webkit-scrollbar {
        display: none;
      }

      .collection-family-slider__card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        scroll-snap-align: start;
        transition: transform .2s ease, box-shadow .2s ease;
      }

      .collection-family-slider__card:hover {
        transform: translateY(-2px);
      }

      .collection-family-slider__image-wrap {
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-color: #ffffff; 
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .collection-family-slider__image-wrap img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: contain !important;
      }

      .collection-family-slider__content {
        padding: 14px;
      }

      .collection-family-slider__title {
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
        text-align: center;
      }

      /* Smart Arrows CSS */
      .collection-family-slider__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 50%;
        background: #fff;
        color: #111;
        display: none; /* Hidden by default until hover */
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
      }
      
      /* Only show arrows on hover IF they don't have the .is-hidden class */
      .collection-family-slider-wrapper:hover .collection-family-slider__arrow:not(.is-hidden) {
        display: flex;
      }

      /* Force hide when JS determines scrolling isn't needed */
      .collection-family-slider__arrow.is-hidden {
        display: none !important;
      }

      .collection-family-slider__arrow--prev {
        left: -14px;
      }

      .collection-family-slider__arrow--next {
        right: -14px;
      }

      @media screen and (max-width: 989px) {
        .collection-family-slider {
          grid-auto-columns: calc((100% - 16px) / 4);
        }
        .collection-family-slider__arrow {
          display: none !important;
        }
      }

      @media screen and (max-width: 749px) {
        .collection-family-slider {
          grid-auto-columns: 40%;
        }
        .collection-family-slider__content {
          padding: 12px;
        }
        .collection-family-slider__title {
          font-size: 15px;
        }
      }
    </style>

    <script>
      (function() {
        var wrapper = document.getElementById('collection-family-slider-{{ section.id | default: "snippet" }}');
        if (!wrapper) return;

        var track = wrapper.querySelector('[data-slider-track]');
        var prevBtn = wrapper.querySelector('[data-slider-prev]');
        var nextBtn = wrapper.querySelector('[data-slider-next]');

        if (!track) return;

        // Smart Arrow Logic
        function updateArrows() {
          // Check if slider contents are wider than the container
          var isScrollable = track.scrollWidth > track.clientWidth;
          
          if (!isScrollable) {
            if (prevBtn) prevBtn.classList.add('is-hidden');
            if (nextBtn) nextBtn.classList.add('is-hidden');
            return;
          }

          // If scrollable, check start/end positions
          var isAtStart = track.scrollLeft <= 0;
          var isAtEnd = Math.ceil(track.scrollLeft + track.clientWidth) >= track.scrollWidth;

          if (prevBtn) {
            if (isAtStart) prevBtn.classList.add('is-hidden');
            else prevBtn.classList.remove('is-hidden');
          }

          if (nextBtn) {
            if (isAtEnd) nextBtn.classList.add('is-hidden');
            else nextBtn.classList.remove('is-hidden');
          }
        }

        function getScrollAmount() {
          var firstCard = track.querySelector('.collection-family-slider__card');
          if (!firstCard) return 300;
          var styles = window.getComputedStyle(track);
          var gap = parseInt(styles.columnGap || styles.gap || 16, 10);
          return firstCard.offsetWidth + gap;
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
          });
        }

        // Run checks on load, scroll, and window resize
        updateArrows();
        track.addEventListener('scroll', updateArrows);
        window.addEventListener('resize', updateArrows);
        
        // Failsafe: Run once more after images load to ensure correct widths
        window.addEventListener('load', updateArrows);
      })();
    </script>
  {% endif %}
{% endif %}