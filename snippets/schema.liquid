{%- comment -%}
GLOBAL JSON-LD SCHEMA (Single file)
- WebSite + SearchAction (global)
- Homepage: Organization + LocalBusiness + WebPage (NO BreadcrumbList)
- Product: BreadcrumbList includes parent category
- Collection: CollectionPage + Organization + FAQPage (only if FAQs exist)
- Social profiles pulled from your theme settings IDs:
  settings.social_facebook, social_twitter, social_pinterest, social_instagram,
  social_vimeo, social_tumblr, social_youtube, social_tiktok, social_linkedin,
  social_snapchat, social_fancy
{%- endcomment -%}

{%- assign shop_url = shop.url -%}

{%- comment -%} Build sameAs array from your settings {%- endcomment -%}
{%- assign socials = '' -%}
{%- if settings.social_facebook  != blank -%}{%- assign socials = socials | append: settings.social_facebook  | append: '||' -%}{%- endif -%}
{%- if settings.social_twitter   != blank -%}{%- assign socials = socials | append: settings.social_twitter   | append: '||' -%}{%- endif -%}
{%- if settings.social_pinterest != blank -%}{%- assign socials = socials | append: settings.social_pinterest | append: '||' -%}{%- endif -%}
{%- if settings.social_instagram != blank -%}{%- assign socials = socials | append: settings.social_instagram | append: '||' -%}{%- endif -%}
{%- if settings.social_vimeo     != blank -%}{%- assign socials = socials | append: settings.social_vimeo     | append: '||' -%}{%- endif -%}
{%- if settings.social_tumblr    != blank -%}{%- assign socials = socials | append: settings.social_tumblr    | append: '||' -%}{%- endif -%}
{%- if settings.social_youtube   != blank -%}{%- assign socials = socials | append: settings.social_youtube   | append: '||' -%}{%- endif -%}
{%- if settings.social_tiktok    != blank -%}{%- assign socials = socials | append: settings.social_tiktok    | append: '||' -%}{%- endif -%}
{%- if settings.social_linkedin  != blank -%}{%- assign socials = socials | append: settings.social_linkedin  | append: '||' -%}{%- endif -%}
{%- if settings.social_snapchat  != blank -%}{%- assign socials = socials | append: settings.social_snapchat  | append: '||' -%}{%- endif -%}
{%- if settings.social_fancy     != blank -%}{%- assign socials = socials | append: settings.social_fancy     | append: '||' -%}{%- endif -%}

{%- assign socials_arr = socials | split: '||' -%}
{%- assign has_social = false -%}
{%- for s in socials_arr -%}
  {%- if s != blank -%}{%- assign has_social = true -%}{%- break -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} 1) WebSite + SearchAction (global, do not duplicate per-page) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ shop_url }}#website",
  "url": {{ shop_url | json }},
  "name": {{ shop.name | json }},
  "publisher": { "@id": "{{ shop_url }}#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop_url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- comment -%}
  2) Page-specific schema.

  The body is CAPTURED first and the <script> is only emitted if a branch actually
  matched. Previously the script opened unconditionally, so any page type without a
  branch (article, page, blog, search, cart, 404) rendered:

      { "@context": "https://schema.org", }

  a dangling comma with no members, which Google reports as "Missing '}' or object
  member name" (Unparsable structured data). Capturing first makes that impossible
  for any page type, now or in future.
{%- endcomment -%}

{%- assign logo_url = 'https://skywardmedical.com/cdn/shop/files/sky_blue_dd34166b-0a8c-4604-8cba-9f70cbb1a3a9.png' -%}

{%- comment -%} Reusable Organization node for the page types added below. {%- endcomment -%}
{%- capture org_node -%}
  {
    "@type": "Organization",
    "@id": "{{ shop_url }}#organization",
    "name": {{ shop.name | json }},
    "url": {{ shop_url | json }},
    "logo": {
      "@type": "ImageObject",
      "@id": "{{ shop_url }}#logo",
      "url": {{ logo_url | json }},
      "contentUrl": {{ logo_url | json }}
    }
    {%- if has_social -%}
    ,
    "sameAs": [
      {%- for s in socials_arr -%}
        {%- if s != blank -%}{{ s | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}
      {%- endfor -%}
    ]
    {%- endif -%}
  }
{%- endcapture -%}

{%- capture page_schema -%}
  {%- if request.page_type == 'index' -%}

  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop_url }}#organization",
      "name": {{ shop.name | json }},
      "url": {{ shop_url | json }},
      "logo": {
        "@type": "ImageObject",
        "@id": "{{ shop_url }}#logo",
        "url": "https://skywardmedical.com/cdn/shop/files/sky_blue_dd34166b-0a8c-4604-8cba-9f70cbb1a3a9.png",
        "contentUrl": "https://skywardmedical.com/cdn/shop/files/sky_blue_dd34166b-0a8c-4604-8cba-9f70cbb1a3a9.png"
      }
      {%- if has_social -%}
      ,
      "sameAs": [
        {%- for s in socials_arr -%}
          {%- if s != blank -%}{{ s | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}
        {%- endfor -%}
      ]
      {%- endif -%}
    },
    {
      "@type": "LocalBusiness",
      "@id": "{{ shop_url }}#localbusiness",
      "name": {{ shop.name | json }},
      "url": {{ shop_url | json }},
      "image": "https://skywardmedical.com/cdn/shop/files/sky_blue_dd34166b-0a8c-4604-8cba-9f70cbb1a3a9.png",
      "parentOrganization": { "@id": "{{ shop_url }}#organization" }
    },
    {
      "@type": "WebPage",
      "@id": "{{ shop_url }}#webpage",
      "url": {{ shop_url | json }},
      "name": {{ shop.name | json }},
      "isPartOf": { "@id": "{{ shop_url }}#website" },
      "about": { "@id": "{{ shop_url }}#organization" },
      "primaryImageOfPage": { "@id": "{{ shop_url }}#logo" }
    }
  ]

  {%- comment -%}
    NOTE: product pages are intentionally NOT handled here. The dedicated product
    block further down already emits @graph[BreadcrumbList, Product]. This branch
    used to emit a SECOND BreadcrumbList with the exact same @id
    ({{ shop_url }}{{ product.url }}#breadcrumb), duplicating that node. Removed.
  {%- endcomment -%}

  {%- elsif request.page_type == 'collection' and collection -%}
    {% assign faq_html = collection.metafields.custom.seo_text_.value %}

"@graph": [

  {
    "@type": "Organization",
    "@id": "{{ shop_url }}#organization",
    "name": {{ shop.name | json }},
    "url": {{ shop_url | json }},
    "logo": {
      "@type": "ImageObject",
      "@id": "{{ shop_url }}#logo",
      "url": "https://skywardmedical.com/cdn/shop/files/sky_blue_dd34166b-0a8c-4604-8cba-9f70cbb1a3a9.png",
      "contentUrl": "https://skywardmedical.com/cdn/shop/files/sky_blue_dd34166b-0a8c-4604-8cba-9f70cbb1a3a9.png"
    }
    {%- if has_social -%}
    ,
    "sameAs": [
      {%- for s in socials_arr -%}
        {%- if s != blank -%}{{ s | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}
      {%- endfor -%}
    ]
    {%- endif -%}
  },

  {
    "@type": "CollectionPage",
    "@id": "{{ shop_url }}{{ collection.url }}#collectionpage",
    "url": {{ shop_url | append: collection.url | json }},
    "name": {{ collection.title | json }},
    {%- if collection.description != blank -%}
    "description": {{ collection.description | strip_html | strip_newlines | json }},
    {%- endif -%}
    "isPartOf": { "@id": "{{ shop_url }}#website" },
    "about": { "@id": "{{ shop_url }}#organization" }
    {% if faq_html contains 'Frequently Asked Questions' %}
      ,
    "hasPart": {
      "@id": "{{ request.origin }}{{ request.path }}#faq"
      } 
    {%- endif -%}

  },

  {
    "@type": "ItemList",
    "@id": "{{ shop_url }}{{ collection.url }}#itemlist",
    "name": {{ collection.title | append: ' Products' | json }},
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "itemListElement": [

      {%- for product in collection.products -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ shop_url | append: product.url | json }},
        "name": {{ product.title | json }},
        "image": {{ product.featured_image | image_url: width: 800 | prepend: "https:" | json }}
      }{%- unless forloop.last -%},{%- endunless -%}

      {%- endfor -%}

    ]
  }
]

  {%- comment -%} Blog article: BlogPosting + breadcrumb. These pages previously had
     NO valid schema at all, only the broken block. {%- endcomment -%}
  {%- elsif request.page_type == 'article' and article -%}
    {%- assign art_modified = article.updated_at | default: article.published_at -%}

"@graph": [

  {{ org_node }},

  {
    "@type": "BlogPosting",
    "@id": "{{ shop_url }}{{ article.url }}#article",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ shop_url }}{{ article.url }}" },
    "headline": {{ article.title | json }},
    "url": {{ shop_url | append: article.url | json }},
    "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
    "dateModified": {{ art_modified | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
    {%- if article.excerpt_or_content != blank -%}
    "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 300 | json }},
    {%- endif -%}
    {%- if article.image -%}
    "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    {%- if article.author != blank -%}
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    {%- endif -%}
    "publisher": { "@id": "{{ shop_url }}#organization" },
    "isPartOf": { "@id": "{{ shop_url }}#website" }
  },

  {
    "@type": "BreadcrumbList",
    "@id": "{{ shop_url }}{{ article.url }}#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop_url | append: blog.url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ shop_url | append: article.url | json }} }
    ]
  }
]

  {%- comment -%} Standard page (/pages/*): WebPage + breadcrumb. {%- endcomment -%}
  {%- elsif request.page_type == 'page' and page -%}

"@graph": [

  {{ org_node }},

  {
    "@type": "WebPage",
    "@id": "{{ shop_url }}{{ page.url }}#webpage",
    "url": {{ shop_url | append: page.url | json }},
    "name": {{ page.title | json }},
    {%- if page.content != blank -%}
    "description": {{ page.content | strip_html | strip_newlines | truncate: 300 | json }},
    {%- endif -%}
    "isPartOf": { "@id": "{{ shop_url }}#website" },
    "about": { "@id": "{{ shop_url }}#organization" }
  },

  {
    "@type": "BreadcrumbList",
    "@id": "{{ shop_url }}{{ page.url }}#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop_url | append: page.url | json }} }
    ]
  }
]

  {%- comment -%} Blog index (/blogs/news): Blog + breadcrumb. {%- endcomment -%}
  {%- elsif request.page_type == 'blog' and blog -%}

"@graph": [

  {{ org_node }},

  {
    "@type": "Blog",
    "@id": "{{ shop_url }}{{ blog.url }}#blog",
    "url": {{ shop_url | append: blog.url | json }},
    "name": {{ blog.title | json }},
    "isPartOf": { "@id": "{{ shop_url }}#website" },
    "publisher": { "@id": "{{ shop_url }}#organization" }
  },

  {
    "@type": "BreadcrumbList",
    "@id": "{{ shop_url }}{{ blog.url }}#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop_url | append: blog.url | json }} }
    ]
  }
]

  {%- endif -%}
{%- endcapture -%}

{%- comment -%} Only emit the script if a branch produced a body. No branch match now
   means NO script tag, instead of an unparsable empty object. {%- endcomment -%}
{%- assign page_schema_check = page_schema | strip -%}
{%- if page_schema_check != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  {{ page_schema }}
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
{%- assign shop_url = shop.url -%}
{%- assign primary_collection = collection | default: product.collections.first -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [

    {
      "@type": "BreadcrumbList",
      "@id": "{{ shop_url }}{{ product.url }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ shop_url }}"
        }
        {%- if primary_collection -%}
        ,
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ primary_collection.title | json }},
          "item": {{ shop_url | append: primary_collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ shop_url | append: product.url | json }}
        }
        {%- else -%}
        ,
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": {{ shop_url | append: product.url | json }}
        }
        {%- endif -%}
      ]
    },

    {
      "@type": "Product",
      "@id": "{{ shop_url }}{{ product.url }}#product",
      "name": {{ product.title | json }},
      "url": {{ shop_url | append: product.url | json }},
      {%- if product.featured_image -%}
      "image": [
        {{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}
      ],
      {%- endif -%}
      {%- if product.description != blank -%}
      "description": {{ product.description | strip_html | strip_newlines | json }},
      {%- endif -%}
      "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ shop.name | json }}
      },

      {%- comment -%} Optional: add GTIN if you store it in variant barcode {%- endcomment -%}
      {%- if product.selected_or_first_available_variant.barcode != blank -%}
      "gtin": {{ product.selected_or_first_available_variant.barcode | json }},
      {%- endif -%}

      {%- if product.vendor != blank and product.vendor != shop.name -%}
      "manufacturer": {
        "@type": "Organization",
        "name": {{ product.vendor | json }}
      },
      {%- endif -%}

      "offers": [
        {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": {{ shop_url | append: variant.url | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ variant.price | money_without_currency | replace: ',', '' | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "sku": {{ variant.sku | default: variant.id | json }}
          {%- if variant.barcode != blank -%}
          ,
          "gtin": {{ variant.barcode | json }}
          {%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
      {%- comment -%}
        reviewCount must be a POSITIVE integer. The guard used to be `!= blank`, but
        0 is not blank in Liquid, so zero-review products emitted "reviewCount": 0 and
        Google rejected them ("Value in property reviewCount must be positive").
        `> 0` omits aggregateRating entirely when there are no reviews, which is the
        same guard microdata-schema.liquid already uses correctly.
      {%- endcomment -%}
      {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0 -%}
      ,
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ product.metafields.reviews.rating.value }},
        "reviewCount": {{ product.metafields.reviews.rating_count.value | json }}
      }
      {%- endif -%}

    }
  ]
}
</script>
{%- endif -%}
