{%- comment -%}
  Nonprofit & Residential Care landing page. Editorial, brand navy + orange.
  Assets load only on this template. Copy is tightened from the client's draft,
  no new product or medical claims.
{%- endcomment -%}

{{ 'sk-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sk-landing.js' | asset_url }}" defer></script>

{%- liquid
  assign phone = section.settings.phone | default: '(855) 244-4712'
  assign tel = phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
  assign contact_url = routes.root_url | append: '/pages/contact' | replace: '//', '/'
  assign quote_link = section.settings.quote_link | default: contact_url
  assign kicker_default = 'prc.landing.kicker' | t
  assign heading_default = 'prc.landing.heading' | t
  assign call_label = 'prc.landing.call_html' | t: phone: phone
  assign hero_fallback = 'https://cdn.shopify.com/s/files/1/0588/8016/3978/files/FrontViewOfTheAccoraFlorBedUltraLowAdjustableBedInAHomecareSetting_3811bf82-3473-41ed-987e-97ff99af8473.jpg?v=1786481202'
  assign commit_fallback = 'https://cdn.shopify.com/s/files/1/0588/8016/3978/files/Non_Profit_Page_Image.webp?v=1786481472'
-%}

<div class="sklp">
  <div class="sklp__wrap">

    {%- comment -%} 1. Hero {%- endcomment -%}
    <section class="sklp-hero">
      <div class="sklp-hero__grid">
        <div class="sklp-hero__text">
          <span class="sklp-kicker">{{ section.settings.kicker | default: kicker_default | escape }}</span>
          <h1 class="sklp-hero__title">{{ section.settings.heading | default: heading_default | escape }}</h1>
          <div class="sklp-hero__lead">
            {%- if section.settings.subtext != blank -%}
              {{ section.settings.subtext }}
            {%- else -%}
              {{ 'prc.landing.lead_html' | t }}
            {%- endif -%}
          </div>
          <div class="sklp-hero__actions">
            <a class="sklp-btn sklp-btn--primary" href="{{ quote_link }}">{{ 'prc.landing.request_quote' | t }}{% render 'sklp-arrow' %}</a>
            <a class="sklp-btn sklp-btn--ghost" href="tel:{{ tel }}">{{ call_label }}</a>
          </div>
        </div>
        <div class="sklp-hero__figure">
          {%- if section.settings.hero_image != blank -%}
            <img src="{{ section.settings.hero_image | image_url: width: 1100 }}"
                 srcset="{{ section.settings.hero_image | image_url: width: 640 }} 640w, {{ section.settings.hero_image | image_url: width: 900 }} 900w, {{ section.settings.hero_image | image_url: width: 1100 }} 1100w"
                 sizes="(min-width: 60rem) 46vw, 100vw"
                 alt="{{ 'prc.landing.hero_alt' | t | escape }}" width="1100" height="825" loading="eager" fetchpriority="high">
          {%- else -%}
            <img src="{{ hero_fallback }}&width=1100"
                 srcset="{{ hero_fallback }}&width=640 640w, {{ hero_fallback }}&width=900 900w, {{ hero_fallback }}&width=1100 1100w"
                 sizes="(min-width: 60rem) 46vw, 100vw"
                 alt="{{ 'prc.landing.hero_alt' | t | escape }}" width="1100" height="825" loading="eager" fetchpriority="high">
          {%- endif -%}
          <span class="sklp-hero__tag"><span class="sklp-dot"></span>{{ 'prc.landing.hero_tag' | t }}</span>
        </div>
      </div>

      <div class="sklp-strip sklp-reveal">
        <ul class="sklp-strip__row">
          <li class="sklp-strip__item">{% render 'sklp-check' %}{{ 'prc.landing.specialist' | t }}</li>
          <li class="sklp-strip__item">{% render 'sklp-check' %}{{ 'prc.landing.manufacturers' | t }}</li>
          <li class="sklp-strip__item">{% render 'sklp-check' %}{{ 'prc.landing.pricing' | t }}</li>
          <li class="sklp-strip__item">{% render 'sklp-check' %}{{ 'prc.landing.tax' | t }}</li>
        </ul>
      </div>
    </section>

    {%- comment -%} 2. What we supply {%- endcomment -%}
    <section class="sklp-move">
      <header class="sklp-head sklp-reveal">
        <h2>{{ 'prc.landing.supply_h' | t }}</h2>
        <p>{{ 'prc.landing.supply_p' | t }}</p>
      </header>
      <div class="sklp-supply">
        <a class="sklp-item sklp-reveal" data-d="1" href="{{ routes.collections_url }}/pediatric-safety-beds">
          <span class="sklp-item__ic">{% render 'sklp-icon', icon: 'safety' %}</span>
          <span>
            <h3>{{ 'prc.landing.safety_h' | t }}</h3>
            <p>{{ 'prc.landing.safety_p' | t }}</p>
            <span class="sklp-item__go">{{ 'prc.landing.safety_go' | t }}</span>
          </span>
        </a>
        <a class="sklp-item sklp-reveal" data-d="2" href="{{ routes.collections_url }}/hi-low-beds">
          <span class="sklp-item__ic">{% render 'sklp-icon', icon: 'hilow' %}</span>
          <span>
            <h3>{{ 'prc.landing.hilow_h' | t }}</h3>
            <p>{{ 'prc.landing.hilow_p' | t }}</p>
            <span class="sklp-item__go">{{ 'prc.landing.hilow_go' | t }}</span>
          </span>
        </a>
        <a class="sklp-item sklp-reveal" data-d="1" href="{{ routes.collections_url }}/hospital-beds">
          <span class="sklp-item__ic">{% render 'sklp-icon', icon: 'homecare' %}</span>
          <span>
            <h3>{{ 'prc.landing.home_h' | t }}</h3>
            <p>{{ 'prc.landing.home_p' | t }}</p>
            <span class="sklp-item__go">{{ 'prc.landing.home_go' | t }}</span>
          </span>
        </a>
        <a class="sklp-item sklp-reveal" data-d="2" href="{{ routes.collections_url }}/pressure-redistribution-mattresses">
          <span class="sklp-item__ic">{% render 'sklp-icon', icon: 'mattress' %}</span>
          <span>
            <h3>{{ 'prc.landing.matt_h' | t }}</h3>
            <p>{{ 'prc.landing.matt_p' | t }}</p>
            <span class="sklp-item__go">{{ 'prc.landing.matt_go' | t }}</span>
          </span>
        </a>
        <a class="sklp-item sklp-reveal" data-d="1" href="{{ routes.collections_url }}/lift-for-elderly">
          <span class="sklp-item__ic">{% render 'sklp-icon', icon: 'lift' %}</span>
          <span>
            <h3>{{ 'prc.landing.lift_h' | t }}</h3>
            <p>{{ 'prc.landing.lift_p' | t }}</p>
            <span class="sklp-item__go">{{ 'prc.landing.lift_go' | t }}</span>
          </span>
        </a>
        <a class="sklp-item sklp-item--talk sklp-reveal" data-d="2" href="{{ quote_link }}">
          <span class="sklp-item__ic">{% render 'sklp-icon', icon: 'chat' %}</span>
          <span>
            <h3>{{ 'prc.landing.talk_h' | t }}</h3>
            <p>{{ 'prc.landing.talk_p' | t }}</p>
            <span class="sklp-item__go sklp-item__go--accent">{{ 'prc.landing.talk_go' | t }}</span>
          </span>
        </a>
      </div>
    </section>

    {%- comment -%} 3. Why partner: light + navy panels {%- endcomment -%}
    <section class="sklp-move">
      <header class="sklp-head sklp-reveal">
        <h2>{{ 'prc.landing.why_h' | t }}</h2>
        <p>{{ 'prc.landing.why_p' | t }}</p>
      </header>
      <div class="sklp-why">
        <div class="sklp-panel sklp-panel--light sklp-reveal" data-d="1">
          <h3>{{ 'prc.landing.program_h' | t }}</h3>
          <ul class="sklp-list">
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.specialist' | t }}</span></li>
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.multi_manuf' | t }}</span></li>
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.personal' | t }}</span></li>
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.pricing_large' | t }}</span></li>
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.tax' | t }}</span></li>
          </ul>
        </div>
        <div class="sklp-panel sklp-panel--navy sklp-reveal" data-d="2">
          <h3>{{ 'prc.landing.simple_h' | t }}</h3>
          <p>{{ 'prc.landing.simple_p' | t }}</p>
          <ul class="sklp-list">
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.faster' | t }}</span></li>
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.wider' | t }}</span></li>
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.wholesale' | t }}</span></li>
            <li>{% render 'sklp-check' %}<span>{{ 'prc.landing.quantity' | t }}</span></li>
          </ul>
        </div>
      </div>
    </section>

    {%- comment -%} 4. Projects: hairline columns {%- endcomment -%}
    <section class="sklp-move">
      <header class="sklp-head sklp-reveal">
        <h2>{{ 'prc.landing.proj_h' | t }}</h2>
      </header>
      <div class="sklp-proj sklp-reveal">
        <div class="sklp-proj__col">
          <h3><span class="sklp-dot"></span>{{ 'prc.landing.single_h' | t }}</h3>
          <p>{{ 'prc.landing.single_p' | t }}</p>
        </div>
        <div class="sklp-proj__col">
          <h3><span class="sklp-dot"></span>{{ 'prc.landing.new_h' | t }}</h3>
          <p>{{ 'prc.landing.new_p' | t }}</p>
        </div>
        <div class="sklp-proj__col">
          <h3><span class="sklp-dot"></span>{{ 'prc.landing.multi_h' | t }}</h3>
          <p>{{ 'prc.landing.multi_p' | t }}</p>
        </div>
      </div>
    </section>

    {%- comment -%} 5. Who we serve: navy band {%- endcomment -%}
    <section class="sklp-serveband sklp-reveal">
      <header class="sklp-head">
        <h2>{{ 'prc.landing.serve_h' | t }}</h2>
        <p>{{ 'prc.landing.serve_p' | t }}</p>
      </header>
      <ul class="sklp-serve">
        <li>{{ 'prc.landing.s1' | t }}</li>
        <li>{{ 'prc.landing.s2' | t }}</li>
        <li>{{ 'prc.landing.s3' | t }}</li>
        <li>{{ 'prc.landing.s4' | t }}</li>
        <li>{{ 'prc.landing.s5' | t }}</li>
        <li>{{ 'prc.landing.s6' | t }}</li>
        <li>{{ 'prc.landing.s7' | t }}</li>
        <li>{{ 'prc.landing.s8' | t }}</li>
        <li>{{ 'prc.landing.s9' | t }}</li>
        <li>{{ 'prc.landing.s10' | t }}</li>
      </ul>
    </section>

    {%- comment -%} 6. Commitment: image + pull quote {%- endcomment -%}
    <section class="sklp-move">
      <div class="sklp-commit">
        <div class="sklp-commit__fig sklp-reveal" data-d="1">
          {%- if section.settings.commitment_image != blank -%}
            <img src="{{ section.settings.commitment_image | image_url: width: 900 }}"
                 srcset="{{ section.settings.commitment_image | image_url: width: 560 }} 560w, {{ section.settings.commitment_image | image_url: width: 900 }} 900w"
                 sizes="(min-width: 60rem) 40vw, 100vw"
                 alt="{{ 'prc.landing.commit_alt' | t | escape }}" width="900" height="600" loading="lazy">
          {%- else -%}
            <img src="{{ commit_fallback }}&width=900"
                 srcset="{{ commit_fallback }}&width=560 560w, {{ commit_fallback }}&width=900 900w"
                 sizes="(min-width: 60rem) 40vw, 100vw"
                 alt="{{ 'prc.landing.commit_alt' | t | escape }}" width="900" height="600" loading="lazy">
          {%- endif -%}
        </div>
        <div class="sklp-commit__text sklp-reveal" data-d="2">
          <p class="sklp-commit__q">{{ 'prc.landing.commit_q' | t }}</p>
          <div class="sklp-commit__body">
            <p>{{ 'prc.landing.commit_p' | t }}</p>
          </div>
        </div>
      </div>
    </section>

    {%- comment -%} 7. Contact CTA {%- endcomment -%}
    <section class="sklp-cta sklp-reveal">
      <h2>{{ 'prc.landing.cta_h' | t }}</h2>
      <p class="sklp-cta__lead">{{ 'prc.landing.cta_p' | t }}</p>
      <ul class="sklp-cta__points">
        <li>{{ 'prc.landing.c1' | t }}</li>
        <li>{{ 'prc.landing.c2' | t }}</li>
        <li>{{ 'prc.landing.c3' | t }}</li>
        <li>{{ 'prc.landing.c4' | t }}</li>
      </ul>
      <div class="sklp-cta__actions">
        <a class="sklp-btn sklp-btn--primary" href="{{ quote_link }}">{{ 'prc.landing.request_quote' | t }}{% render 'sklp-arrow' %}</a>
        <a class="sklp-btn sklp-btn--onDark" href="tel:{{ tel }}">{{ call_label }}</a>
      </div>
    </section>

  </div>
</div>

{% schema %}
{
  "name": "Nonprofit care landing",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "info": "Leave blank to use the translated default." },
    { "type": "text", "id": "heading", "label": "Hero heading", "info": "Leave blank to use the translated default." },
    { "type": "richtext", "id": "subtext", "label": "Hero text" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(855) 244-4712" },
    { "type": "url", "id": "quote_link", "label": "Request a quote link", "info": "Defaults to the contact page." },
    { "type": "image_picker", "id": "commitment_image", "label": "Commitment image" }
  ],
  "presets": [ { "name": "Nonprofit care landing" } ]
}
{% endschema %}
